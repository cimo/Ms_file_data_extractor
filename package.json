{
    "name": "ms_file_data_extractor",
    "version": "1.0.0",
    "description": "Microservice file data extractor.",
    "author": "cimo",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cimo/Ms_file_data_extractor.git"
    },
    "type": "module",
    "scripts": {
        "delete_dist": "node -e \"const fs = require('fs'); try{ fs.rmdirSync('./dist/', { recursive: true }) } catch{}; process.exit(0);\"",
        "check": "eslint --no-cache --config eslint.config.js",
        "build_tsc": "npm run delete_dist && tsc --build tsconfig.tsc.json",
        "build": "npm run build_tsc && npm run check",
        "execute": "nodemon --config nodemon.json"
    },
    "dependencies": {
        "@cimo/authentication": "1.2.3",
        "@cimo/environment": "1.0.33",
        "@cimo/cronjob": "1.0.21",
        "@cimo/form-data_parser": "1.1.53",
        "@cimo/queue": "1.0.14",
        "express": "5.3.0",
        "express-rate-limit": "8.6.2",
        "cookie-parser": "1.4.7",
        "cors": "2.8.6",
        "http-compression": "1.1.3"
    },
    "devDependencies": {
        "@types/node": "25.3.0",
        "@types/express": "5.0.0",
        "@types/cookie-parser": "1.4.8",
        "@types/cors": "2.8.17",
        "@typescript-eslint/parser": "8.65.0",
        "@typescript-eslint/eslint-plugin": "8.65.0",
        "typescript": "5.7.2",
        "nodemon": "3.1.14",
        "prettier": "3.4.2",
        "eslint": "10.10.0",
        "eslint-plugin-prettier": "5.5.6"
    },
    "overrides": {}
}
